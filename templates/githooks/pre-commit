#!/bin/sh
# figma-code-sync: offline map/token check when the design surface is staged.
# Enable once per clone: npx figma-code-sync hooks
# Widen the path filter to your token source and component directories.
#
# Resolves a LOCAL install only (node_modules/.bin, or a global binary). It never
# calls the npm registry: the package is installed from GitHub, so `npx` with
# nothing installed would 404 and block every commit.
if git diff --cached --name-only | grep -qE '^(design/|figma-sync\.config\.js)'; then
  if [ -x node_modules/.bin/figma-code-sync ]; then
    FCS=node_modules/.bin/figma-code-sync
  elif command -v figma-code-sync >/dev/null 2>&1; then
    FCS=figma-code-sync
  else
    echo "pre-commit: figma-code-sync is not installed, skipping the design check"
    echo "            npm i -D github:jasonchandesign/figma-code-sync#v0.1.0"
    exit 0
  fi
  "$FCS" check || {
    echo "pre-commit: figma-code-sync check failed — see design/WORKFLOW.md"
    exit 1
  }
fi
